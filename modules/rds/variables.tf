variable "name" {
  description = "Identifier for the DB instance and prefix for its subnet group, parameter group and security group."
  type        = string
}

variable "engine" {
  description = "Database engine, such as postgres or mysql."
  type        = string
  default     = "postgres"
}

variable "engine_version" {
  description = "Engine version. A major version alone (\"17\") lets RDS pick the latest minor."
  type        = string
  default     = "17"
}

variable "parameter_group_family" {
  description = "Parameter group family, such as postgres17. Null derives it from engine and the major version."
  type        = string
  default     = null
}

variable "parameters" {
  description = "Database parameters to set, as name = value. Applied at the next reboot."
  type        = map(string)
  default     = {}
}

variable "instance_class" {
  description = "Instance size. db.t4g.micro is the cheapest Graviton class."
  type        = string
  default     = "db.t4g.micro"
}

variable "db_name" {
  description = "Name of the database created at launch."
  type        = string
}

variable "username" {
  description = "Master user name. The password is generated by RDS and kept in Secrets Manager."
  type        = string
  default     = "dbadmin"
}

variable "port" {
  description = "Port the database listens on."
  type        = number
  default     = 5432
}

variable "allocated_storage" {
  description = "Initial storage in GiB."
  type        = number
  default     = 20
}

variable "max_allocated_storage" {
  description = "Storage autoscaling ceiling in GiB. 0 turns autoscaling off."
  type        = number
  default     = 0
}

variable "kms_key_id" {
  description = "KMS key ARN for storage encryption. Null uses the AWS managed key."
  type        = string
  default     = null
}

variable "multi_az" {
  description = "Run a synchronous standby in a second AZ that RDS fails over to automatically. Doubles the instance cost."
  type        = bool
  default     = false
}

variable "vpc_id" {
  description = "VPC for the database security group."
  type        = string
}

variable "subnet_ids" {
  description = "Private subnets in at least two AZs for the DB subnet group."
  type        = list(string)

  validation {
    condition     = length(var.subnet_ids) >= 2
    error_message = "RDS needs subnets in at least two AZs."
  }
}

variable "allowed_security_groups" {
  description = "Security groups allowed to connect on the database port, keyed by a static label such as eks_nodes. A map, because the IDs are often unknown until apply."
  type        = map(string)
  default     = {}
}

variable "allowed_cidr_blocks" {
  description = "CIDRs allowed to connect on the database port. Prefer allowed_security_groups."
  type        = list(string)
  default     = []
}

variable "backup_retention_days" {
  description = "Days of automated backups. 0 turns backups off, 1 is the minimum for point-in-time restore."
  type        = number
  default     = 1
}

variable "apply_immediately" {
  description = "Apply changes now instead of in the next maintenance window."
  type        = bool
  default     = true
}

variable "performance_insights_enabled" {
  description = "Turn on Performance Insights (7 days free on most classes)."
  type        = bool
  default     = false
}

variable "deletion_protection" {
  description = "Refuse to delete the instance until this is turned off. Use true in production."
  type        = bool
  default     = false
}

variable "skip_final_snapshot" {
  description = "Delete without a final snapshot. Fine for labs that reseed data; use false in production."
  type        = bool
  default     = true
}

variable "tags" {
  description = "Additional tags to apply to every resource."
  type        = map(string)
  default     = {}
}
